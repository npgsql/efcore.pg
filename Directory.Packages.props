  <Project>
  <PropertyGroup>
    <EFCoreVersion>11.0.0-rc.3.26522.148</EFCoreVersion>
    <EFCoreNextMajorVersion>12.0.0-a</EFCoreNextMajorVersion>
    <MicrosoftExtensionsVersion>11.0.0-rc.3.26522.148</MicrosoftExtensionsVersion>
    <MicrosoftExtensionsConfigurationVersion>11.0.0-rc.3.26522.148</MicrosoftExtensionsConfigurationVersion>
    <NpgsqlVersion>10.0.3</NpgsqlVersion>
    <XunitVersion>4.0.1</XunitVersion>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Depend on anything from the EF version we build against up to (but excluding) the next major version, including its prereleases.
      This mirrors the ranges EF's own packages use (e.g. >= 11.0.0-rc.3.26522.148 && < 12.0.0-a), and allows users to pick up newer
      EF previews/RCs/patches (e.g. out-of-band security releases) without waiting for a new EFCore.PG release.
      The upper bound of 12.0.0-a excludes all 12.0.0 prereleases, since "a" sorts before "alpha", "preview" and "rc".
    -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="[$(EFCoreVersion), $(EFCoreNextMajorVersion))" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Abstractions" Version="[$(EFCoreVersion), $(EFCoreNextMajorVersion))" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational.Specification.Tests" Version="[$(EFCoreVersion), $(EFCoreNextMajorVersion))" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="[$(EFCoreVersion), $(EFCoreNextMajorVersion))" />

    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="$(MicrosoftExtensionsConfigurationVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="$(MicrosoftExtensionsConfigurationVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="$(MicrosoftExtensionsVersion)" />

    <PackageVersion Include="Npgsql" Version="$(NpgsqlVersion)" />
    <PackageVersion Include="Npgsql.NodaTime" Version="$(NpgsqlVersion)" />
    <PackageVersion Include="Npgsql.NetTopologySuite" Version="$(NpgsqlVersion)" />
    <PackageVersion Include="Npgsql.DependencyInjection" Version="$(NpgsqlVersion)" />

    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.401" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="Microsoft.DotNet.XUnitV3Extensions" Version="11.0.0-beta.26467.112" />
    <PackageVersion Include="xunit.v3" Version="$(XunitVersion)" />
    <PackageVersion Include="xunit.v3.runner.inproc.console" Version="$(XunitVersion)" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.15.0" />
  </ItemGroup>
</Project>
